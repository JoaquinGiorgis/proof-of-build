# --- Solana -----------------------------------------------------------------
# Devnet, always. Your own RPC — the public endpoint falls over during a demo.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# The issuer keypair, 64-byte secret, base58 or a JSON array.
# Generate it with `pnpm issuer:keygen`. Server-only. Never commit it.
ISSUER_SECRET_KEY=

# --- Database (Supabase) ------------------------------------------------------
# The pooled (transaction-mode, port 6543) connection string.
DATABASE_URL=

# --- Site ---------------------------------------------------------------------
# Absolute origin, used for metadata URLs written into the credential onchain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
