# --- Solana -----------------------------------------------------------------
# devnet or mainnet-beta. Local work stays on devnet; production decides for
# itself. On mainnet the builder pays real SOL and the mints are permanent.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Your own RPC — the public endpoint falls over during a demo, and on mainnet
# it rate-limits far harder than on devnet. Get a Triton key before the event.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# The issuer keypair, 64-byte secret, base58 or a JSON array.
# Generate it with `pnpm issuer:keygen`. Server-only. Never commit it.
ISSUER_SECRET_KEY=

# Signs the claim links an event's own system issues. SHARED with that system
# — the same value has to be on both sides or signatures will not verify.
# Generate with: openssl rand -base64 36
CLAIM_LINK_SECRET=

# --- Database (Supabase) ------------------------------------------------------
# The pooled (transaction-mode, port 6543) connection string.
DATABASE_URL=

# --- Site ---------------------------------------------------------------------
# Absolute origin, used for metadata URLs written into the credential onchain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
